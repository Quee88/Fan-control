<ui:FluentWindow x:Class="FanControl.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:FanControl.ViewModels"
                 xmlns:controls="clr-namespace:FanControl.Controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="Fan Control"
                 Icon="pack://application:,,,/Assets/fan.ico"
                 Width="1040" Height="760" MinWidth="760" MinHeight="540"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Fan Control">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/fan.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Levá navigace ===== -->
            <DockPanel Grid.Column="0" Margin="10,6,6,12">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Margin="12,0" FontSize="11"
                           Style="{StaticResource Secondary}" />
                <StackPanel>
                    <RadioButton x:Name="NavFans" Style="{StaticResource NavItemStyle}" IsChecked="True" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource FanGeometry}" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Viewbox>
                            <TextBlock Text="Větráky" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSensors" Style="{StaticResource NavItemStyle}" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Temperature24" FontSize="18" />
                            <TextBlock Text="Senzory" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItemStyle}" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                            <TextBlock Text="Nastavení" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <!-- ===== Obsah ===== -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <Grid>

                    <!-- ===================== VĚTRÁKY ===================== -->
                    <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavFans, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,22,28,28" MaxWidth="980">
                            <TextBlock Text="Větráky" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding HardwareSummary}" Style="{StaticResource Secondary}" Margin="0,2,0,16" />

                            <ui:InfoBar Title="Aplikace neběží jako správce" Severity="Warning" IsOpen="{Binding ShowAdminWarning, Mode=OneWay}"
                                        IsClosable="False" Margin="0,0,0,12"
                                        Message="Bez práv správce nemusí jít číst teplotu procesoru ani ovládat větráky na základní desce. Spusť aplikaci pravým tlačítkem → Spustit jako správce." />

                            <ui:InfoBar Severity="Informational" IsOpen="{Binding ShowPawnIoWarning, Mode=OneWay}" IsClosable="False" Margin="0,0,0,12"
                                        Title="Chybí ovladač PawnIO"
                                        Message="Je potřeba pro čtení teploty procesoru a řízení větráků na základní desce. Grafická karta funguje i bez něj.">
                                <ui:InfoBar.Content>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <ui:Button Content="Nainstalovat PawnIO" Appearance="Primary" Command="{Binding InstallPawnIoCommand}"
                                                   Visibility="{Binding PawnIoNeedsRestart, Converter={StaticResource InverseBoolToVis}}" />
                                        <ui:Button Content="Restartovat aplikaci" Appearance="Primary" Command="{Binding RestartAppCommand}"
                                                   Visibility="{Binding PawnIoNeedsRestart, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding PawnIoStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </ui:InfoBar.Content>
                            </ui:InfoBar>

                            <!-- Dlaždice s teplotami -->
                            <ItemsControl ItemsSource="{Binding Headlines}" Margin="-6,0,-6,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HeadlineViewModel}">
                                        <ui:Card Margin="6" Padding="18,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Temperature24" FontSize="28" Foreground="#E87020" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Text}" FontSize="30" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Načítání -->
                            <StackPanel Orientation="Horizontal" Margin="0,30" HorizontalAlignment="Center"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" />
                                <TextBlock Text="Hledám hardware… (může to trvat pár sekund)" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <ui:InfoBar Title="Hardware se nepodařilo načíst" Severity="Error" IsClosable="False"
                                        IsOpen="{Binding HasLoadError, Mode=OneWay}" Message="{Binding LoadError}" />

                            <!-- Žádné ovladatelné větráky -->
                            <ui:Card Visibility="{Binding ShowNoFans, Converter={StaticResource BoolToVis}}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Nenašel jsem žádný větrák, který by šel ovládat" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0"
                                               Text="Některé značkové počítače (HP, Dell, Lenovo…) řídí větráky vlastním firmwarem a nedovolí to programům ve Windows. Rychlost pak jde změnit jen v BIOSu (u HP obvykle Advanced → Thermal / Fan Idle Mode). Teploty a otáčky najdeš v sekci Senzory." />
                                </StackPanel>
                            </ui:Card>

                            <!-- Karty větráků -->
                            <ItemsControl ItemsSource="{Binding Fans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FanViewModel}">
                                        <ui:Card Margin="0,0,0,14" Padding="20,18">
                                            <StackPanel>
                                                <!-- Hlavička -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <Viewbox Width="26" Height="26">
                                                            <Path Data="{StaticResource FanGeometry}" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </Viewbox>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVis}}">
                                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <ui:Button Icon="{ui:SymbolIcon Edit20}" Appearance="Transparent" BorderThickness="0" Padding="6"
                                                                       Margin="6,0,0,0" Command="{Binding StartRenameCommand}" ToolTip="Přejmenovat" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}">
                                                            <ui:TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Width="240" PlaceholderText="Název větráku">
                                                                <ui:TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter" Command="{Binding ConfirmRenameCommand}" />
                                                                    <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                                                </ui:TextBox.InputBindings>
                                                            </ui:TextBox>
                                                            <ui:Button Icon="{ui:SymbolIcon Checkmark20}" Margin="6,0,0,0" Appearance="Primary"
                                                                       Command="{Binding ConfirmRenameCommand}" ToolTip="Uložit" />
                                                            <ui:Button Icon="{ui:SymbolIcon Dismiss20}" Margin="6,0,0,0"
                                                                       Command="{Binding CancelRenameCommand}" ToolTip="Zrušit" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding HardwareName}" FontSize="12" Style="{StaticResource Secondary}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding PercentText}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding RpmText}" FontSize="12" Style="{StaticResource Secondary}" HorizontalAlignment="Right"
                                                                   Visibility="{Binding HasRpm, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>

                                                <ProgressBar Value="{Binding PercentValue, Mode=OneWay}" Maximum="100" Height="4" Margin="0,14,0,16" />

                                                <!-- Režim -->
                                                <Border HorizontalAlignment="Left" CornerRadius="7" Padding="2"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsAuto}" Content="Automaticky" />
                                                        <RadioButton Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsManual}" Content="Ručně" />
                                                        <RadioButton Style="{StaticResource SegmentStyle}" IsChecked="{Binding IsCurve}" Content="Podle teploty" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource Secondary}" Margin="2,10,0,0" />

                                                <!-- Ruční režim -->
                                                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="70" />
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding ManualPercent}" IsSnapToTickEnabled="True"
                                                                TickFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ManualPercentText}" FontSize="18" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <ui:Button Content="30 %" Command="{Binding SetManualCommand}" CommandParameter="30" Margin="0,0,6,0" />
                                                        <ui:Button Content="50 %" Command="{Binding SetManualCommand}" CommandParameter="50" Margin="0,0,6,0" />
                                                        <ui:Button Content="70 %" Command="{Binding SetManualCommand}" CommandParameter="70" Margin="0,0,6,0" />
                                                        <ui:Button Content="100 %" Command="{Binding SetManualCommand}" CommandParameter="100" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Křivka -->
                                                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsCurve, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" MaxWidth="420" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Řídit podle:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding TemperatureOptions}" SelectedItem="{Binding SelectedSource}"
                                                                  DisplayMemberPath="Display" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="Předvolby:" VerticalAlignment="Center" Margin="12,0,8,0" Style="{StaticResource Secondary}" />
                                                            <ui:Button Content="Tichý" Command="{Binding ApplyPresetCommand}" CommandParameter="silent" Margin="0,0,6,0" />
                                                            <ui:Button Content="Vyvážený" Command="{Binding ApplyPresetCommand}" CommandParameter="balanced" Margin="0,0,6,0" />
                                                            <ui:Button Content="Výkonný" Command="{Binding ApplyPresetCommand}" CommandParameter="performance" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Margin="0,14,0,0" CornerRadius="6" Padding="6,8"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                        <controls:CurveEditor Height="280"
                                                                              Points="{Binding CurvePoints}"
                                                                              CurrentTemperature="{Binding LiveSourceTemperature}"
                                                                              EditedCommand="{Binding CurveEditedCommand}" />
                                                    </Border>

                                                    <Expander Margin="0,12,0,0" Header="Pokročilé">
                                                        <Grid Margin="0,8,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="60" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Hystereze" FontWeight="SemiBold" />
                                                                <TextBlock Style="{StaticResource Secondary}" FontSize="12"
                                                                           Text="Větrák zpomalí, až teplota klesne alespoň o tuto hodnotu. Zabraňuje neustálému kolísání otáček." />
                                                            </StackPanel>
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding Hysteresis}"
                                                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="12,0" />
                                                            <TextBlock Grid.Column="2" Text="{Binding HysteresisText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Expander>
                                                </StackPanel>

                                                <ui:InfoBar Margin="0,14,0,0" Severity="Warning" IsClosable="False" Title="Pozor"
                                                            IsOpen="{Binding HasProblem, Mode=OneWay}" Message="{Binding Problem}" />
                                            </StackPanel>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== SENZORY ===================== -->
                    <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavSensors, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,22,28,28" MaxWidth="980">
                            <TextBlock Text="Senzory" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Všechny teploty a otáčky, které se podařilo přečíst. Minimum a maximum platí od spuštění aplikace."
                                       Style="{StaticResource Secondary}" Margin="0,2,0,16" />

                            <ItemsControl ItemsSource="{Binding SensorGroups}" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SensorGroupViewModel}">
                                        <ui:Card Margin="0,0,0,12" Padding="18,14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Category}" FontSize="12" Style="{StaticResource Secondary}" />
                                                <TextBlock Text="{Binding HardwareName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" SharedSizeGroup="Kind" />
                                                        <ColumnDefinition Width="110" SharedSizeGroup="Val" />
                                                        <ColumnDefinition Width="110" SharedSizeGroup="Min" />
                                                        <ColumnDefinition Width="110" SharedSizeGroup="Max" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Senzor" FontSize="12" Style="{StaticResource Secondary}" />
                                                    <TextBlock Grid.Column="1" Text="Typ" FontSize="12" Style="{StaticResource Secondary}" />
                                                    <TextBlock Grid.Column="2" Text="Aktuálně" FontSize="12" Style="{StaticResource Secondary}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="Minimum" FontSize="12" Style="{StaticResource Secondary}" TextAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="Maximum" FontSize="12" Style="{StaticResource Secondary}" TextAlignment="Right" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Sensors}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SensorViewModel}">
                                                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="110" SharedSizeGroup="Kind" />
                                                                        <ColumnDefinition Width="110" SharedSizeGroup="Val" />
                                                                        <ColumnDefinition Width="110" SharedSizeGroup="Min" />
                                                                        <ColumnDefinition Width="110" SharedSizeGroup="Max" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Secondary}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" TextAlignment="Right" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding Min}" Style="{StaticResource Secondary}" TextAlignment="Right" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding Max}" Style="{StaticResource Secondary}" TextAlignment="Right" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===================== NASTAVENÍ ===================== -->
                    <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,22,28,28" MaxWidth="980">
                            <TextBlock Text="Nastavení" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />

                            <TextBlock Text="Vzhled a chování" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Motiv" FontWeight="SemiBold" />
                                        <TextBlock Text="Barevný režim aplikace" Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox SelectedIndex="{Binding ThemeIndex}" MinWidth="170">
                                    <ComboBoxItem Content="Podle systému" />
                                    <ComboBoxItem Content="Světlý" />
                                    <ComboBoxItem Content="Tmavý" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Spouštět po přihlášení do Windows" FontWeight="SemiBold" />
                                        <TextBlock Text="Bez dotazu na oprávnění – přes Plánovač úloh" Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
                            </ui:CardControl>

                            <ui:InfoBar Severity="Error" IsClosable="False" Margin="0,0,0,4" Title="Chyba"
                                        IsOpen="{Binding HasStartupError, Mode=OneWay}" Message="{Binding StartupError}" />

                            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon TrayItemRemove24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Po automatickém spuštění neotevírat okno" FontWeight="SemiBold" />
                                        <TextBlock Text="Aplikace se schová do oznamovací oblasti vedle hodin" Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Dismiss24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Křížek okno jen skryje" FontWeight="SemiBold" />
                                        <TextBlock Text="Větráky se dál řídí na pozadí. Úplně ukončit jde z ikony v oznamovací oblasti." Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon ArrowClockwise24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Interval aktualizace" FontWeight="SemiBold" />
                                        <TextBlock Text="Jak často se čtou teploty a upravují otáčky" Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Width="180" Minimum="0.5" Maximum="3" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Value="{Binding UpdateIntervalSeconds}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UpdateIntervalText}" Width="50" TextAlignment="Right" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:CardControl>

                            <TextBlock Text="Hardware" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DeveloperBoard24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Ovladač PawnIO" FontWeight="SemiBold" />
                                        <TextBlock Text="Potřebný pro teplotu procesoru a větráky na základní desce" Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PawnIoStatus}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ui:Button Content="Nainstalovat" Command="{Binding InstallPawnIoCommand}"
                                               Visibility="{Binding ShowPawnIoWarning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon ArrowReset24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Vrátit všechny větráky na automatiku" FontWeight="SemiBold" />
                                        <TextBlock Text="Řízení převezme ovladač grafické karty a BIOS" Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="Vrátit" Command="{Binding ResetAllToAutoCommand}" />
                            </ui:CardControl>

                            <TextBlock Text="O aplikaci" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Složka s nastavením a logem" FontWeight="SemiBold" />
                                        <TextBlock Text="%AppData%\Fan-control" Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="Otevřít" Command="{Binding OpenDataFolderCommand}" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Code24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Fan Control" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Secondary}" FontSize="12" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="GitHub" Icon="{ui:SymbolIcon Open20}" Command="{Binding OpenProjectPageCommand}" />
                            </ui:CardControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
